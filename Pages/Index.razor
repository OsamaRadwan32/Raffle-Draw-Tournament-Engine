@page "/"
@layout HomeLayout
@inject NavigationManager Nav

<script src="js/drawSounds.js"></script>

<div class="home-container">
    <div class="home-card">
        <img src="images/newLogo.png" alt="Tournament Logo" class="home-logo" />

        <h1 class="home-title">Padel Tournament 2 </h1>
        <p class="home-subtitle">December 2025 Draw</p>

        <div class="home-actions">
            <button class="home-btn" @onclick="GoPlayers">Register Players</button>
            <button class="home-btn" @onclick="GoTeams">Create Teams</button>
            <button class="home-btn" @onclick="GoGroups">Group Draw</button>
            @* <button class="home-btn" @onclick="GoKnockout">Knockout Draw</button> *@
            <button class="home-btn" @onclick="GoKnockoutOverview">Knockout Overview</button>
        </div>

        <span class="home-powered">
            Powered by Jubaili App Team
        </span>
    </div>
</div>

@code {
    private void GoPlayers() => Nav.NavigateTo("/players");
    private void GoTeams() => Nav.NavigateTo("/teams");
    private void GoGroups() => Nav.NavigateTo("/groups");
    private void GoKnockout() => Nav.NavigateTo("/knockout");
    private void GoKnockoutOverview() => Nav.NavigateTo("/knockout/overview");
}