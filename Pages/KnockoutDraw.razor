@page "/knockout"
@using PadelTournamentApp.Data
@inject SeedService SeedData

<h2 class="page-title">Knockout Draw</h2>

<div class="knockout-layout">

    <!-- LEFT: GROUPS (spectator only) -->
    <aside class="groups-panel">
        <h3>Groups</h3>

        @foreach (var g in SeedData.Groups)
        {
            <div class="group-box">
                <strong>@g.GroupName</strong>
                <ul>
                    @foreach (var tid in g.TeamIds)
                    {
                        var t = SeedData.Teams.FirstOrDefault(x => x.Id == tid);
                        if (t != null)
                        {
                            <li>@t.Name</li>
                        }
                    }
                </ul>
            </div>
        }
    </aside>

    <!-- CENTER: DRAW -->
    <section class="draw-panel">

        @if (!isReady)
        {
            <p class="empty">@notReadyMessage</p>
        }
        else
        {
            <h3 class="section-title">@CurrentStepTitle</h3>

            @* <div class="current-seed">
                <span class="seed-label">Current Draw:</span>
                <span class="seed-value">@currentSeed</span>
            </div> *@

            <div class="raffle-box">
                <span class="shuffle-text">
                    @(isShuffling? shuffleText : "Press Draw")
                </span>
            </div>

            <div class="draw-controls">
                <button class="btn-draw" @onclick="DrawNext">
                    Draw
                </button>

                <button class="btn-reset" @onclick="ResetKnockout" disabled="@isShuffling">
                    Reset Knockout
                </button>
            </div>

            <div class="matches">

                @if (SeedData.Knockout.Any(m => m.Stage == "QuarterFinal"))
                {
                    <h4 class="matches-stage">Quarter Finals</h4>

                    @foreach (var m in SeedData.Knockout.Where(m => m.Stage == "QuarterFinal"))
                    {
                        <div class="match-card">
                            <div class="match-left">
                                <div class="match-title">@m.Label</div>
                                <div class="match-sep"></div>
                            </div>

                            <div class="match-center">
                                <div class="match-sides">
                                    <span>@m.SideA</span>
                                    <strong>vs</strong>
                                    <span>@m.SideB</span>
                                </div>
                            </div>
                        </div>

                    }
                }

                @if (SeedData.Knockout.Any(m => m.Stage == "SemiFinal"))
                {
                    <h4 class="matches-stage">Semi Finals</h4>

                    @foreach (var m in SeedData.Knockout.Where(m => m.Stage == "SemiFinal"))
                    {
                        <div class="match-card">
                            <div class="match-left">
                                <div class="match-title">@m.Label</div>
                                <div class="match-sep"></div>
                            </div>

                            <div class="match-center">
                                <div class="match-sides">

                                    <span>@m.SideA</span>
                                    <strong>vs</strong>
                                    <span>@m.SideB</span>
                                </div>
                            </div>

                        </div>
                    }
                }

            </div>

        }

    </section>

</div>

@code {

    private enum KnockoutStep
    {
        QuarterFinals,
        SemiFinals,
        Completed
    }

    private KnockoutStep CurrentStep = KnockoutStep.QuarterFinals;

    private bool isReady;
    private bool isShuffling;
    private string shuffleText = "";
    private string currentSeed = "";
    private string notReadyMessage = "At least 2 groups are required.";

    private readonly Random rnd = new();

    // Quarter Final pools
    private List<string> qfLeaders = new();
    private List<string> qfRunners = new();

    // Semi Final pool
    private List<string> sfSeeds = new();

    protected override void OnInitialized()
    {
        if (SeedData.Groups == null || SeedData.Groups.Count < 2)
        {
            isReady = false;
            return;
        }

        isReady = true;

        var groupNames = SeedData.Groups
        .Select(g => g.GroupName.Trim())
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct()
        .OrderBy(n => n)
        .ToList();

        qfLeaders = groupNames.Select(n => $"Winner {n}").ToList();
        qfRunners = groupNames.Select(n => $"Runner-up {n}").ToList();

        Shuffle(qfLeaders);
        Shuffle(qfRunners);

        SeedData.Knockout ??= new();

        if (SeedData.Knockout.Any(m => m.Stage == "SemiFinal"))
        {
            CurrentStep = KnockoutStep.Completed;
        }
        else if (SeedData.Knockout.Any(m => m.Stage == "QuarterFinal"))
        {
            MoveToSemiFinals();
        }

        UpdateCurrentSeed();
    }

    private string CurrentStepTitle =>
    CurrentStep == KnockoutStep.QuarterFinals ? "Quarter-Final Draw" :
    CurrentStep == KnockoutStep.SemiFinals ? "Semi-Final Draw" :
    "Draw Completed";

    private async Task DrawNext()
    {
        // HARD GUARDS (no UI lockups)
        if (!isReady)
        {
            shuffleText = "Knockout not ready";
            StateHasChanged();
            return;
        }

        if (isShuffling)
            return;

        if (CurrentStep == KnockoutStep.Completed)
        {
            shuffleText = "Draw completed";
            StateHasChanged();
            return;
        }

        isShuffling = true;
        shuffleText = "";
        StateHasChanged();

        try
        {
            if (CurrentStep == KnockoutStep.QuarterFinals)
            {
                await DrawQuarterFinal();
            }
            else if (CurrentStep == KnockoutStep.SemiFinals)
            {
                await DrawSemiFinal();
            }

            await Persist();
            UpdateCurrentSeed();
        }
        finally
        {
            isShuffling = false;
            StateHasChanged();
        }
    }


    private async Task DrawQuarterFinal()
    {
        if (qfLeaders.Count == 0)
        {
            MoveToSemiFinals();
            return;
        }

        var leader = qfLeaders[rnd.Next(qfLeaders.Count)];
        var leaderGroup = leader.Replace("Winner ", "");

        var eligibleRunners = qfRunners
        .Where(r => !r.Contains(leaderGroup))
        .ToList();

        if (!eligibleRunners.Any())
            eligibleRunners = qfRunners.ToList();

        for (int i = 0; i < 16; i++)
        {
            shuffleText = $"{leader} vs {eligibleRunners[rnd.Next(eligibleRunners.Count)]}";
            StateHasChanged();
            await Task.Delay(90);
        }

        var opponent = eligibleRunners[rnd.Next(eligibleRunners.Count)];

        SeedData.Knockout.Add(new KnockoutMatch
        {
            Label = $"Quarter Final {SeedData.Knockout.Count(m => m.Stage == "QuarterFinal") + 1}",
            Stage = "QuarterFinal",
            SideA = leader,
            SideB = opponent
        });

        qfLeaders.Remove(leader);
        qfRunners.Remove(opponent);

        if (qfLeaders.Count == 0)
            MoveToSemiFinals();
    }

    private async Task DrawSemiFinal()
    {
        if (sfSeeds.Count < 2)
        {
            CurrentStep = KnockoutStep.Completed;
            return;
        }

        var a = sfSeeds[rnd.Next(sfSeeds.Count)];
        sfSeeds.Remove(a);

        var b = sfSeeds[rnd.Next(sfSeeds.Count)];
        sfSeeds.Remove(b);

        for (int i = 0; i < 16; i++)
        {
            shuffleText = $"{a} vs {b}";
            StateHasChanged();
            await Task.Delay(90);
        }

        SeedData.Knockout.Add(new KnockoutMatch
        {
            Label = $"Semi Final {SeedData.Knockout.Count(m => m.Stage == "SemiFinal") + 1}",
            Stage = "SemiFinal",
            SideA = a,
            SideB = b
        });

        if (sfSeeds.Count == 0)
            CurrentStep = KnockoutStep.Completed;
    }

    private void MoveToSemiFinals()
    {
        CurrentStep = KnockoutStep.SemiFinals;

        sfSeeds = Enumerable.Range(1, SeedData.Knockout.Count(m => m.Stage == "QuarterFinal"))
        .Select(i => $"Winner of Quarter Final {i}")
        .ToList();

        Shuffle(sfSeeds);
    }

    private void UpdateCurrentSeed()
    {
        currentSeed =
        CurrentStep == KnockoutStep.QuarterFinals && qfLeaders.Any()
        ? qfLeaders[rnd.Next(qfLeaders.Count)]
        : CurrentStep == KnockoutStep.SemiFinals && sfSeeds.Any()
        ? sfSeeds[rnd.Next(sfSeeds.Count)]
        : "Completed";
    }

    private async Task Persist()
    {
        if (SeedData.GetType().GetMethod("SaveAsync") != null)
            await SeedData.SaveAsync();
        else
            SeedData.Save();
    }

    private async Task ResetKnockout()
    {
        SeedData.Knockout.Clear();
        CurrentStep = KnockoutStep.QuarterFinals;
        OnInitialized();
        await Persist();
        StateHasChanged();
    }

    private void Shuffle<T>(IList<T> list)
    {
        for (int i = list.Count - 1; i > 0; i--)
        {
            int j = rnd.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
    }
}