@page "/groups/draw"
@using PadelTournamentApp.Models
@using PadelTournamentApp.Data
@using PadelTournamentApp.Components.Draw
@inject SeedService SeedData
@inject NavigationManager Nav

<h2 class="page-title">Group Draw</h2>

<div class="page-center">

@if (!teamsReady)
{
    <p class="empty">You must create teams before generating the group draw.</p>
    <button class="btn-add" @onclick="GoToTeams">Go to Teams</button>
}
else
{
    <!-- REMAINING TEAMS -->
    <div class="remaining-container">
        <h3 class="section-title">
            Teams Remaining: @allRemainingTeams.Count
        </h3>

        <div class="remaining-grid">
            @foreach (var tid in allRemainingTeams)
            {
                var t = SeedData.Teams.First(x => x.Id == tid);
                var p1 = SeedData.Players.First(p => p.Id == t.Player1Id);
                var p2 = SeedData.Players.First(p => p.Id == t.Player2Id);

                <div class="team-box">
                    @p1.Name & @p2.Name
                </div>
            }
        </div>
    </div>

    <!-- DRAW BOX -->
    <TeamDrawBox @ref="drawBox"
                OnTeamSelected="HandleTeamSelected" />

    <!-- CONTROLS -->
    <div class="draw-controls">
        <button class="btn-draw"
                @onclick="BeginShuffle"
                disabled="@(!canDraw)">
            Draw Team
        </button>

        <button class="btn-reset"
                @onclick="ResetDraw">
            Reset Draw
        </button>
    </div>

    <p class="status">@statusMessage</p>

    <!-- GROUPS -->
    <div class="groups-container">
        @for (int i = 0; i < Groups.Count; i++)
        {
            var g = Groups[i];

            <div class="group-card @(highlightedGroupIndex == i ? "group-highlight" : "")">
                <h3>@g.GroupName</h3>

                <ul>
                    @foreach (var tid in g.TeamIds)
                    {
                        var t = SeedData.Teams.First(t => t.Id == tid);
                        var p1 = SeedData.Players.First(p => p.Id == t.Player1Id);
                        var p2 = SeedData.Players.First(p => p.Id == t.Player2Id);

                        <li>@p1.Name & @p2.Name</li>
                    }
                </ul>
            </div>
        }
    </div>
}

</div>

@code {
    private TeamDrawBox? drawBox;

    private List<Group> Groups = new();
    private Dictionary<int, List<int>> rankedPools = new();
    private List<int> remainingRankPool = new();
    private List<int> allRemainingTeams = new();

    private int currentRank;
    private bool teamsReady;
    private bool canDraw;

    private int highlightedGroupIndex = -1;
    private string statusMessage = string.Empty;

    protected override void OnInitialized()
    {
        teamsReady = SeedData.Teams.Count >= 2;
        if (!teamsReady) return;

        Groups = SeedData.Groups.Count > 0
            ? SeedData.Groups
            : CreateGroups();

        rankedPools = SeedData.Teams
            .GroupBy(t => t.Rank)
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.Select(t => t.Id).ToList());

        var assigned = Groups.SelectMany(g => g.TeamIds).ToHashSet();

        allRemainingTeams = SeedData.Teams
            .Where(t => !assigned.Contains(t.Id))
            .Select(t => t.Id)
            .ToList();

        currentRank = allRemainingTeams.Count > 0
            ? SeedData.Teams
                .Where(t => allRemainingTeams.Contains(t.Id))
                .Min(t => t.Rank)
            : rankedPools.Keys.Max();

        LoadNextRankPool();
    }

    private List<Group> CreateGroups()
    {
        int totalTeams = SeedData.Teams.Count;
        int groupCount = (int)Math.Ceiling(totalTeams / 4.0);

        var groups = new List<Group>();

        for (int i = 0; i < groupCount; i++)
        {
            groups.Add(new Group
            {
                GroupName = $"Group {(char)('A' + i)}"
            });
        }

        SeedData.Groups = groups;
        SeedData.Save();

        return groups;
    }

    private void LoadNextRankPool()
    {
        if (!rankedPools.ContainsKey(currentRank))
        {
            canDraw = false;
            statusMessage = "Draw complete!";
            return;
        }

        var assigned = Groups.SelectMany(g => g.TeamIds).ToHashSet();

        remainingRankPool = rankedPools[currentRank]
            .Where(id => !assigned.Contains(id))
            .ToList();

        if (remainingRankPool.Count == 0)
        {
            currentRank++;
            LoadNextRankPool();
            return;
        }

        canDraw = true;
        statusMessage = string.Empty;
    }

    private async Task BeginShuffle()
    {
        if (drawBox == null || remainingRankPool.Count == 0)
            return;

        if (remainingRankPool.Count == 1)
        {
            await HandleTeamSelected(remainingRankPool[0]);
            return;
        }

        statusMessage = "Drawing...";
        await drawBox.StartDraw(remainingRankPool);
    }

    private async Task HandleTeamSelected(int teamId)
    {
        int totalAssigned = Groups.Sum(g => g.TeamIds.Count);
        int groupIndex = totalAssigned % Groups.Count;

        Groups[groupIndex].TeamIds.Add(teamId);

        remainingRankPool.Remove(teamId);
        allRemainingTeams.Remove(teamId);

        SeedData.Save();

        highlightedGroupIndex = groupIndex;
        await Task.Delay(400);
        highlightedGroupIndex = -1;

        if (remainingRankPool.Count == 0)
        {
            currentRank++;
            LoadNextRankPool();
        }

        StateHasChanged();

        // Refresh the page after saving to avoid hydration overlays
        Nav.NavigateTo("/groups/draw", forceLoad: true);
    }

    private void ResetDraw()
    {
        Groups = CreateGroups();
        currentRank = rankedPools.Keys.Min();
        LoadNextRankPool();
        Nav.NavigateTo("/groups/draw", true);
    }

    private void GoToTeams() => Nav.NavigateTo("/teams", true);
}
