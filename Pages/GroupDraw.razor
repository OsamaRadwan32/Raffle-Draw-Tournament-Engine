@page "/groups"
@using Microsoft.Extensions.Logging
@using PadelTournamentApp.Models
@using PadelTournamentApp.Data
@using PadelTournamentApp.Components.Draw
@inject SeedService SeedData
@inject NavigationManager Nav
@inject ILogger<GroupDraw> Logger

<div class="page-header-card">
    <h2 class="page-title">Group Stage Draw
        <span class="page-title-date">- 29th December 2025</span>
    </h2>
</div>

<div class="page-center">

    @if (!teamsReady)
    {
        <p class="empty">You must create teams before generating the group draw.</p>
        <button class="btn-add" @onclick="GoToTeams">Go to Teams</button>
    }
    else
    {
        <!-- GROUPS -->
        <div class="groups-container">
            @for (int i = 0; i < Groups.Count; i++)
            {
                var g = Groups[i];

                <div
                    class="group-card @(highlightedGroupIndex == i ? "group-highlight" : "")  @(drawCompleted ? "group-final" : "")">
                    <h3>@g.GroupName</h3>

                    <ul>
                        @foreach (var tid in g.TeamIds)
                        {
                            var t = SeedData.Teams.FirstOrDefault(t => t.Id == tid);
                            var p1 = t == null ? null : SeedData.Players.FirstOrDefault(p => p.Id == t.Player1Id);
                            var p2 = t == null ? null : SeedData.Players.FirstOrDefault(p => p.Id == t.Player2Id);

                            if (t == null || p1 == null || p2 == null)
                            {
                                Logger?.LogWarning(
                                "[GroupDraw] Skipping group render for team id {TeamId} (team found: {HasTeam}, p1: {P1}, p2: {P2})",
                                tid,
                                t != null,
                                t?.Player1Id,
                                t?.Player2Id);
                                continue;
                            }

                            <li>@p1.Name & @p2.Name</li>
                        }
                    </ul>
                </div>
            }
        </div>

        <!-- DRAW BOX -->
        <TeamDrawBox @ref="drawBox" OnTeamSelected="HandleTeamSelected" />

        <!-- CONTROLS -->
        <div class="draw-controls">
            <button class="btn-draw" @onclick="BeginShuffle" disabled="@(!canDraw)">
                Draw Team
            </button>

            <button class="btn-reset" @onclick="ResetDraw">
                Reset Draw
            </button>
        </div>

        @* <p class="status">@statusMessage</p> *@

        <!-- REMAINING TEAMS -->
        <div class="remaining-container">
            <h3 class="section-title">
                Teams Remaining: @allRemainingTeams.Count
            </h3>

            <div class="remaining-grid">
                @foreach (var tid in allRemainingTeams)
                {
                    var t = SeedData.Teams.FirstOrDefault(x => x.Id == tid);
                    var p1 = t == null ? null : SeedData.Players.FirstOrDefault(p => p.Id == t.Player1Id);
                    var p2 = t == null ? null : SeedData.Players.FirstOrDefault(p => p.Id == t.Player2Id);

                    if (t == null || p1 == null || p2 == null)
                    {
                        Logger?.LogWarning(
                        "[GroupDraw] Skipping remaining team id {TeamId} (team found: {HasTeam}, p1: {P1}, p2: {P2})",
                        tid,
                        t != null,
                        t?.Player1Id,
                        t?.Player2Id);
                        continue;
                    }

                    <div class="team-box">
                        @p1.Name & @p2.Name
                    </div>
                }
            </div>
        </div>
    }

</div>

@code {
    private TeamDrawBox? drawBox;

    private List<Group> Groups = new();
    private Dictionary<int, List<int>> rankedPools = new();
    private List<int> remainingRankPool = new();
    private List<int> allRemainingTeams = new();

    private int currentRank;
    private bool teamsReady;
    private bool canDraw;

    private int highlightedGroupIndex = -1;
    private string statusMessage = string.Empty;

    private List<int> rankCycle = new();
    private int rankCursor = 0;
    private bool drawCompleted;
    private int drawsFromCurrentRank = 0;
    private int drawsPerRankRound => Groups.Count; // usually 4

    // BACKEND-ONLY FLAG (no UI)
    private const bool AUTO_DRAW_ALL = true;

    protected override void OnInitialized()
    {
        teamsReady = SeedData.Teams.Count >= 2;
        if (!teamsReady)
            return;

        // Initialize or load groups
        Groups = SeedData.Groups.Count > 0
        ? SeedData.Groups
        : CreateGroups();

        // Build ranked pools (Rank → TeamIds)
        rankedPools = SeedData.Teams
        .GroupBy(t => t.Rank)
        .OrderBy(g => g.Key)
        .ToDictionary(
        g => g.Key,
        g => g.Select(t => t.Id).ToList()
        );

        // Determine already assigned teams
        var assigned = Groups
        .SelectMany(g => g.TeamIds)
        .ToHashSet();

        // All remaining teams (rank-neutral, UI shuffle source)
        allRemainingTeams = SeedData.Teams
        .Where(t => !assigned.Contains(t.Id))
        .Select(t => t.Id)
        .ToList();

        // 🔑 Build rank cycle (round-robin over ranks)
        rankCycle = rankedPools
        .Where(kvp => kvp.Value.Any(id => !assigned.Contains(id)))
        .Select(kvp => kvp.Key)
        .OrderBy(r => r)
        .ToList();

        rankCursor = rankCycle.Count > 1 ? 1 : 0;
        if (rankCursor < 0)
            rankCursor = 0;

        // Load first drawable rank pool
        LoadNextRankPool();
    }


    private List<Group> CreateGroups()
    {
        int totalTeams = SeedData.Teams.Count;
        int groupCount = (int)Math.Ceiling(totalTeams / 4.0);

        var groups = new List<Group>();

        for (int i = 0; i < groupCount; i++)
        {
            groups.Add(new Group
            {
                GroupName = $"Group {(char)('A' + i)}"
            });
        }

        SeedData.Groups = groups;
        SeedData.Save();

        return groups;
    }

    private void LoadNextRankPool()
    {
        if (rankCycle.Count == 0)
        {
            canDraw = false;
            statusMessage = "Draw complete!";
            return;
        }

        var assigned = Groups.SelectMany(g => g.TeamIds).ToHashSet();

        // Cycle ranks (round-robin)
        currentRank = rankCycle[rankCursor];

        remainingRankPool = rankedPools[currentRank]
        .Where(id => !assigned.Contains(id))
        .ToList();

        // If this rank is exhausted, remove it and recurse
        if (remainingRankPool.Count == 0)
        {
            rankCycle.RemoveAt(rankCursor);
            if (rankCursor >= rankCycle.Count)
                rankCursor = 0;

            LoadNextRankPool();
            return;
        }

        canDraw = true;
    }

    private async Task BeginShuffle()
    {
        if (drawBox == null || !canDraw)
            return;

        var shufflePool = allRemainingTeams.ToList();
        var selectionPool = remainingRankPool.ToList();

        statusMessage = "Drawing...";

        // ❌ Only skip shuffle if this is the LAST TEAM OVERALL
        if (allRemainingTeams.Count == 1)
        {
            await HandleTeamSelected(allRemainingTeams[0]);
            return;
        }

        await drawBox.StartDraw(shufflePool, selectionPool);
    }

    private async Task HandleTeamSelected(int teamId)
    {
        // Determine group
        int totalAssigned = Groups.Sum(g => g.TeamIds.Count);
        int groupIndex = totalAssigned % Groups.Count;

        // Mutate state (pure data changes only)
        Groups[groupIndex].TeamIds.Add(teamId);
        remainingRankPool.Remove(teamId);
        allRemainingTeams.Remove(teamId);

        highlightedGroupIndex = groupIndex;

        // Allow highlight to be visible
        await Task.Delay(400);

        highlightedGroupIndex = -1;

        drawsFromCurrentRank++;

        // Switch rank ONLY after one full group round
        if (drawsFromCurrentRank >= drawsPerRankRound || remainingRankPool.Count == 0)
        {
            drawsFromCurrentRank = 0;

            // 🔑 Advance to next rank in cycle
            rankCursor = (rankCursor + 1) % rankCycle.Count;

            LoadNextRankPool();
        }

        if (allRemainingTeams.Count == 1)
        {
            int lastTeamId = allRemainingTeams[0];

            // Mark draw as completed BEFORE recursion
            drawCompleted = true;

            // 🔑 Force UI re-render so scaling animation applies
            StateHasChanged();

            // Small delay so animation is visible
            await Task.Delay(600);

            await HandleTeamSelected(lastTeamId);
            return;
        }

        if (allRemainingTeams.Count == 0)
        {
            drawCompleted = true;
            StateHasChanged();
        }

        // Persist AFTER everything is stable
        await SeedData.SaveAsync();
    }

    private void ResetDraw()
    {
        Groups = CreateGroups();
        currentRank = rankedPools.Keys.Min();
        LoadNextRankPool();
        Nav.NavigateTo("/groups", true);
    }

    private void GoToTeams() => Nav.NavigateTo("/teams", true);
}